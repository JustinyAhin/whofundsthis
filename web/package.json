{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --env-file .env.example --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --env-file .env.example --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun test",
		"calibrate": "bun scripts/calibrate-funding-search.ts",
		"calibrate:joint": "bun --no-env-file scripts/evaluate-joint-policies.ts",
		"calibrate:recorded": "bun scripts/evaluate-recorded-calibration.ts",
		"calibrate:ranking": "bun scripts/evaluate-ranking-policies.ts",
		"calibrate:regressions": "bun --no-env-file scripts/evaluate-ranking-regressions.ts",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"gen": "wrangler types --env-file .env.example"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/bun": "^1.4.0",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"webmcp-types": "0.1.5",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"bits-ui": "^2.19.0",
		"valibot": "^1.4.2"
	}
}
